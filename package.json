{
  "name": "@ardurai/ranking-engine",
  "version": "0.1.0",
  "private": false,
  "description": "Multi-signal scoring (interaction, credibility, recency, source diversity) with full audit trail for the Ardur AI content pipeline",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./dist/index.js",
    "./contracts": "./dist/contracts.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types src/smoke.test.ts",
    "rank": "node --experimental-strip-types src/cli.ts"
  },
  "keywords": [
    "ardur",
    "ranking",
    "scoring",
    "credibility",
    "content-pipeline"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ArdurAI/ardur-ranking-engine.git"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^22.10.0"
  }
}
